{
  "name": "@intentui/ui-kit",
  "version": "0.0.1",
  "description": "Ready-to-use, accessible, and beautifully styled Generative UI components for IntentUI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": ">=3.4.0",
    "zod": "^3.23"
  },
  "dependencies": {
    "@intentui/core": "workspace:*",
    "@intentui/vue": "workspace:*"
  },
  "devDependencies": {
    "unplugin-vue": "^7.2.0"
  },
  "license": "MIT"
}
