{
  "name": "@intentui-vue/ui-kit",
  "version": "1.0.0",
  "description": "Ready-to-use, accessible, and beautifully styled Generative UI components for IntentUI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": ">=3.4.0",
    "zod": "^3.23"
  },
  "dependencies": {
    "@intentui-vue/core": "workspace:*",
    "@intentui-vue/vue": "workspace:*"
  },
  "devDependencies": {
    "unplugin-vue": "^7.2.0"
  },
  "license": "MIT",
  "style": "./dist/style.css"
}