{
  "name": "@intentui/nuxt",
  "version": "0.0.1",
  "description": "Official Nuxt 3 module for IntentUI — Generative UI with zero-config auto-imports and secure server streaming",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run"
  },
  "peerDependencies": {
    "nuxt": ">=3.0.0",
    "vue": ">=3.4.0",
    "zod": "^3.23"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "dependencies": {
    "@intentui/core": "workspace:*",
    "@intentui/vue": "workspace:*",
    "@nuxt/kit": "^3.15.0",
    "@nuxt/schema": "^3.15.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "h3": "2.0.1-rc.29"
  }
}
